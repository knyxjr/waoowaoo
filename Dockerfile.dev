FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache tini git

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm install
RUN touch .env

# Source code is bind-mounted by docker-compose.dev.yml.
# Build once on container start so updates require a restart.

EXPOSE 3000 3010

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "touch .env && npm run build && npx prisma db push --skip-generate && npm run start"]
